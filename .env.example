# Copia in .env (o incolla questi valori nella tab Environment di Dokploy).
# Genera password robuste, NON usare questi placeholder.

# --- Database (MariaDB) ---
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=cambiami-utente-db-32char
DB_ROOT_PASSWORD=cambiami-root-db-32char

# --- Redis object cache ---
REDIS_PASSWORD=cambiami-redis-32char
# Prefisso/DB univoci per ogni sito se condividi un Redis fra più WordPress.
# Con questo stack il Redis è dedicato, quindi 0 va bene.
WP_REDIS_PREFIX=wp1
WP_REDIS_DATABASE=0

# --- Debug (0 in produzione) ---
WORDPRESS_DEBUG=0